# ==============================================================================
# Template Konfigurasi Environment - Voting Pemilihan Kakang Senduk Ponorogo
# Salin file ini menjadi ".env" pada server produksi/lokal dan sesuaikan nilainya.
# PERINGATAN: Jangan pernah mengunggah file ".env" asli ke repository Git!
# ==============================================================================

# Lingkungan aplikasi: "development" (lokal) atau "production" (server live)
APP_ENV=production

# URL dasar aplikasi relatif terhadap domain:
# - Kosongkan ("") / "auto" untuk deteksi otomatis (root domain atau subfolder)
# - Isi "/" untuk memaksa root domain (contoh: https://voting.ponorogo.go.id)
# - Isi "/voting-kakang-senduk" jika ingin menentukan subfolder secara eksplisit
APP_BASE_URL=

# Paksa redirect HTTP ke HTTPS saat APP_ENV=production ("true" atau "false")
FORCE_HTTPS=true

# Zona waktu aplikasi
APP_TIMEZONE=Asia/Jakarta
APP_TIMEZONE_OFFSET=+07:00

# Konfigurasi Database MySQL 8 / MariaDB (Hosting / Produksi)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_voting_kakang_senduk
DB_USER=isi_user_database_produksi
DB_PASS=isi_password_database_yang_kuat
DB_CHARSET=utf8mb4

